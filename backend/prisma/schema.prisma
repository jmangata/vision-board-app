// Schéma Prisma de Vision Board.
// Ce fichier définit le modèle de données relationnel : utilisateurs, objectifs, étapes,
// catégories, rappels et badges. Chaque modèle est mappé explicitement vers une table PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Utilisateur de l'application. La suppression d'un utilisateur cascade sur ses objectifs et badges.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstname    String
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")
  streakDays   Int       @default(1) @map("streak_days")

  goals      Goal[]
  reminders  Reminder[]
  badges     UserBadge[]
  slideshows Slideshow[]

  @@map("users")
}

// Catégorie thématique des objectifs (Santé, Carrière, etc.).
model Category {
  id    String @id @default(uuid())
  name  String @unique
  color String
  icon  String

  goals Goal[]

  @@map("categories")
}

// Objectif créé par un utilisateur, rattaché à une catégorie et découpé en étapes.
model Goal {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  categoryId  String    @map("category_id")
  title       String
  description String?
  imageUrl    String?   @map("image_url")
  targetDate  DateTime? @map("target_date")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  steps     Step[]
  reminders Reminder[]

  @@map("goals")
}

// Étape concrète d'un objectif. L'ordre permet d'afficher les étapes dans une séquence logique.
model Step {
  id          String    @id @default(uuid())
  goalId      String    @map("goal_id")
  title       String
  isCompleted Boolean   @default(false) @map("is_completed")
  order       Int
  completedAt DateTime? @map("completed_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("steps")
}

// Rappel périodique associé à un objectif et à un utilisateur.
model Reminder {
  id            String   @id @default(uuid())
  goalId        String   @map("goal_id")
  userId        String   @map("user_id")
  frequency     String
  nextTriggerAt DateTime @map("next_trigger_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// Badge déblocable par un utilisateur selon une condition métier (conditionKey).
model Badge {
  id           String @id @default(uuid())
  name         String @unique
  icon         String
  description  String
  conditionKey String @map("condition_key")

  users UserBadge[]

  @@map("badges")
}

// Table de jointure garantissant qu'un utilisateur ne gagne qu'une fois chaque badge.
model UserBadge {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Slideshow {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slides Slide[]

  @@map("slideshows")
}

model Slide {
  id          String   @id @default(uuid())
  slideshowId String   @map("slideshow_id")
  title       String
  content     String?
  imageUrl    String?  @map("image_url")
  order       Int
  duration    Int      @default(5)
  createdAt   DateTime @default(now()) @map("created_at")

  slideshow Slideshow @relation(fields: [slideshowId], references: [id], onDelete: Cascade)

  @@index([slideshowId, order])
  @@map("slides")
}
