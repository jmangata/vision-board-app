// Schéma de la base de données PostgreSQL (Prisma ORM).
// Convention : les champs camelCase côté JS sont mappés en snake_case
// en base via @map, et chaque modèle est mappé sur une table via @@map.
// Les suppressions sont en cascade : supprimer un User ou un Goal
// supprime toutes ses données liées (steps, reminders, badges...).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Utilisateur de l'application : identité, authentification et streak
// de connexion (nombre de jours consécutifs d'activité).
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstname    String
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")
  // Streak : nombre de jours consécutifs de connexion (sert au badge streak_7)
  streakDays   Int       @default(1) @map("streak_days")

  goals     Goal[]
  reminders Reminder[]
  badges    UserBadge[]

  @@map("users")
}

// Catégorie de classement des objectifs (référentiel commun, seedé au départ)
model Category {
  id    String @id @default(uuid())
  name  String @unique
  color String
  icon  String

  goals Goal[]

  @@map("categories")
}

// Objectif utilisateur : l'entité centrale de l'application.
// status peut valoir "active", "completed" ou "abandoned".
model Goal {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  categoryId  String    @map("category_id")
  title       String
  description String?
  imageUrl    String?   @map("image_url")
  targetDate  DateTime? @map("target_date")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  steps     Step[]
  reminders Reminder[]

  @@map("goals")
}

// Étape (sous-tâche ordonnée) d'un objectif.
// completedAt est renseigné uniquement quand isCompleted passe à true.
model Step {
  id          String    @id @default(uuid())
  goalId      String    @map("goal_id")
  title       String
  isCompleted Boolean   @default(false) @map("is_completed")
  order       Int
  completedAt DateTime? @map("completed_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("steps")
}

// Rappel périodique par email lié à un objectif.
// nextTriggerAt = prochaine échéance, recalculée par le job cron après envoi.
// frequency peut valoir "daily", "weekly" ou "monthly".
model Reminder {
  id            String   @id @default(uuid())
  goalId        String   @map("goal_id")
  userId        String   @map("user_id")
  frequency     String
  nextTriggerAt DateTime @map("next_trigger_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// Badge du catalogue : récompense déblocable.
// conditionKey est la clé technique évaluée dans services/badgeService.js
// (ex. "first_goal", "five_completed", "streak_7", "explorer").
model Badge {
  id           String @id @default(uuid())
  name         String @unique
  icon         String
  description  String
  conditionKey String @map("condition_key")

  users UserBadge[]

  @@map("badges")
}

// Table de jointure : badge effectivement débloqué par un utilisateur.
// La contrainte d'unicité (userId, badgeId) empêche les doublons.
model UserBadge {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}
