# Base de données PostgreSQL (docker-compose : port 5433)
DATABASE_URL=postgresql://postgres:root@localhost:5433/visionboard

# Authentification JWT
JWT_SECRET=changez-moi-en-production
JWT_EXPIRES_IN=7d

# Cloudinary — stockage des images d'objectifs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Unsplash — recherche d'images d'inspiration
UNSPLASH_ACCESS_KEY=

# Groq — suggestions d'étapes par IA
GROQ_API_KEY=

# Serveur
PORT=5000
NODE_ENV=development

# URL du frontend web — utilisée pour construire le lien de réinitialisation de mot de passe
FRONTEND_URL=http://localhost:5173

# CORS — origines autorisées en production (séparées par des virgules)
ALLOWED_ORIGINS=https://votre-frontend.onrender.com

# SMTP — envoi des rappels par email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse expéditrice — doit être un expéditeur vérifié chez le fournisseur (ex. Mailjet)
MAIL_FROM=votre@email.com
